# Turso Database Configuration
# Get these from: https://app.turso.tech
TURSO_DATABASE_URL=libsql://tu-database-url.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui


# RapidAPI Key — para el comando !play (youtube-mp36)
# Consigue la tuya en: https://rapidapi.com/ytjar/api/youtube-mp36
RAPIDAPI_KEY=tu-rapidapi-key-aqui

# Bot Configuration
PORT=7860
NUMERO_ADMIN=50760541202
# Numero del bot: el que se vincula con el codigo de 8 digitos.
# UN solo numero con codigo de pais, sin + ni espacios (ej: 50761234567).
NUMERO_BOT=50761234567

# Vinculacion: 'both' (defecto) = QR y codigo, 'qr' = solo QR, 'code' = solo codigo
PAIRING_METHOD=both

# --- Rendimiento (opcionales: si no se definen, usan estos valores) ---
# Tareas pesadas simultaneas (ffmpeg). Render Free 512MB: 3. Servidor grande: 6-8.
MAX_PROCESOS=3
# Pausa base entre mensajes del mismo chat (ms). Se sube sola a 250ms si el
# chat venia de un timeout/429. Bajar de 80 solo si WhatsApp no rate-limita.
PERF_QUEUE_MIN_MS=80
# Mensajes procesados en paralelo como maximo (proteccion contra OOM en picos).
PERF_MAX_MSG_CONCURRENT=16
# Nivel de logs de Baileys: silent | error | warn | info | debug
BAILEYS_LOG_LEVEL=silent

# Plataforma: Hugging Face Spaces
# Configura las variables en: Settings → Repository secrets
